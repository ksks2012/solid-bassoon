#version 430 core

// ═══════════════════════════════════════════════════════════════════════════════
// Schwarzschild null-geodesic ray tracer (Compute Shader)
//
// Each thread traces one pixel's light ray backwards through curved spacetime
// using 4th-order Runge-Kutta integration of the geodesic equation in the
// Hamiltonian formulation:
//
//   dx^μ/dλ =  g^{μν} p_ν
//   dp_μ/dλ = -½ ∂g^{αβ}/∂x^μ · p_α p_β
//
// Termination conditions:
//   CAPTURED   r ≤ rs          → black
//   ESCAPED    r > abort_dist  → sky colour (based on direction)
//   MAX_STEPS  budget exhausted → debug magenta
// ═══════════════════════════════════════════════════════════════════════════════

layout (local_size_x = 16, local_size_y = 16) in;

layout (rgba32f, binding = 0) uniform writeonly image2D outputImage;

// Uniforms set from C++
uniform float u_mass;
uniform float u_rs;
uniform float u_cam_distance;
uniform float u_cam_inclination;  // degrees
uniform float u_cam_fov;          // degrees
uniform int   u_max_steps;
uniform float u_step_size;
uniform float u_abort_distance;
uniform ivec2 u_resolution;

// ── Point light source on the celestial sphere (for Einstein ring) ────────────
// Position in Boyer-Lindquist angular coordinates.
// When the source is directly behind the BH (θ_src ≈ θ_obs, φ_src ≈ π),
// gravitational lensing produces a complete Einstein ring.
uniform float u_src_theta;        // colatitude of point source (degrees)
uniform float u_src_phi;          // azimuth of point source (degrees)
uniform float u_src_radius;       // angular radius on sky (degrees) — controls apparent size
uniform float u_src_brightness;   // brightness multiplier (0 = disabled)

// ── Thin accretion disk (equatorial plane) ────────────────────────────────────
// The disk lies at θ = π/2 from r_in to r_out.  During integration we detect
// equatorial crossings and colour the ray if it lands on the disk.
uniform float u_disk_inner;       // inner radius (≥ ISCO for physical disk)
uniform float u_disk_outer;       // outer radius
uniform float u_disk_temp;        // peak temperature (normalised brightness)
uniform int   u_disk_enabled;     // 0 = off, 1 = on

// ── Display / tone mapping ────────────────────────────────────────────────────
// Global display transform applied once at the end of main().  The shader
// accumulates LINEAR HDR radiance; these uniforms map it to displayable LDR.
uniform float u_exposure;         // linear exposure multiplier (default 1.0)
uniform float u_gamma;            // display gamma (default 1.0 = identity)

// ── Relativistic jet (optically thin, additive) ───────────────────────────────
// Bipolar, axisymmetric, emission-only jet.  Geometry and transverse/axial
// profile arrived in tickets 0004–0005; relativistic Doppler beaming δ^(3+α)
// in ticket 0006.  The whole accumulation is gated on u_jet_enabled so the
// disabled path costs essentially nothing.
uniform int   u_jet_enabled;          // 0 = off (default), 1 = on
uniform float u_jet_base_radius;      // cone foot radius at z = 0
uniform float u_jet_opening_angle;    // half-opening angle (degrees)
uniform float u_jet_profile_exponent; // shape exponent: 1 = cone, 0.5 = parabola
uniform float u_jet_max_height;       // axial extent of the jet
uniform float u_jet_radial_sigma;     // transverse Gaussian width
uniform float u_jet_z_falloff;        // axial falloff length scale
uniform float u_jet_axial_falloff;    // axial power-law exponent
uniform float u_jet_bulk_velocity;    // β (constant)
uniform float u_jet_spectral_index;   // α in the beaming exponent δ^(3+α)
uniform float u_jet_emissivity;       // master brightness multiplier

// ── Constants ─────────────────────────────────────────────────────────────────

const float PI = 3.14159265358979323846;

// Relativistic jet emission colour: cool blue-white (synchrotron-like).
const vec3 JET_COLOR = vec3(0.55, 0.72, 1.0);

// ── Geodesic RHS ──────────────────────────────────────────────────────────────
// State: vec4 pos = (t, r, θ, φ),  vec4 mom = (p_t, p_r, p_θ, p_φ)
// Returns: dpos/dλ in out_dx,  dmom/dλ in out_dp

void geodesicRHS(vec4 pos, vec4 mom, float rs,
                 out vec4 out_dx, out vec4 out_dp)
{
    float r     = pos.y;
    float theta = pos.z;

    float pt  = mom.x;
    float pr  = mom.y;
    float pth = mom.z;
    float pph = mom.w;

    float f    = 1.0 - rs / r;
    float r2   = r * r;
    float r3   = r2 * r;
    float sth  = sin(theta);
    float cth  = cos(theta);

    // Prevent division by zero: guard f and sin²θ for float precision
    float f_safe  = (abs(f) < 1e-7) ? sign(f) * 1e-7 : f;
    float f2      = f_safe * f_safe;
    float s2      = max(sth * sth, 1e-8);
    float s3      = s2 * max(abs(sth), 1e-4);

    // dx^μ/dλ
    out_dx.x = -pt  / f_safe;        // dt/dλ
    out_dx.y =  f   * pr;            // dr/dλ  (use exact f here, not f_safe)
    out_dx.z =  pth / r2;            // dθ/dλ
    out_dx.w =  pph / (r2 * s2);     // dφ/dλ

    // dp_μ/dλ
    out_dp.x = 0.0;                                          // energy conserved
    out_dp.y = -0.5 * (
        +rs / (r2 * f2) * pt  * pt
        + rs /  r2       * pr  * pr
        - 2.0 /  r3      * pth * pth
        - 2.0 / (r3*s2)  * pph * pph
    );
    out_dp.z = cth / (r2 * s3) * pph * pph;                 // dp_θ/dλ
    out_dp.w = 0.0;                                          // angular momentum conserved
}

// ── RK4 step ──────────────────────────────────────────────────────────────────

void rk4Step(inout vec4 pos, inout vec4 mom, float rs, float h) {
    vec4 dx1, dp1, dx2, dp2, dx3, dp3, dx4, dp4;

    geodesicRHS(pos, mom, rs, dx1, dp1);
    geodesicRHS(pos + 0.5*h*dx1, mom + 0.5*h*dp1, rs, dx2, dp2);
    geodesicRHS(pos + 0.5*h*dx2, mom + 0.5*h*dp2, rs, dx3, dp3);
    geodesicRHS(pos + h*dx3,     mom + h*dp3,     rs, dx4, dp4);

    pos += (h / 6.0) * (dx1 + 2.0*dx2 + 2.0*dx3 + dx4);
    mom += (h / 6.0) * (dp1 + 2.0*dp2 + 2.0*dp3 + dp4);
}

// ── Ray initialisation ────────────────────────────────────────────────────────
//
// Camera model using the LOCAL ORTHONORMAL FRAME of a static observer.
//
// At the observer position (r_obs, θ_obs, φ=0), the orthonormal tetrad is:
//   ê_(t) = (1/√f) ∂_t
//   ê_(r) = √f     ∂_r
//   ê_(θ) = (1/r)  ∂_θ
//   ê_(φ) = (1/(r sinθ)) ∂_φ
//
// The camera looks radially inward (−ê_(r) direction).
// Screen axes: x → ê_(φ),  y → −ê_(θ)  (θ increases "downward").
//
// For each pixel, compute a local 3-direction n = (n_r, n_θ, n_φ) with |n|=1:
//   n_r  = −cos(β)·cos(α)    (inward)
//   n_θ  =  sin(β)           (up = −θ direction, but sign handled by β)
//   n_φ  =  cos(β)·sin(α)    (right)
//
// where α = horizontal angle, β = vertical angle from FOV mapping.
//
// Convert to covariant momenta:
//   p_t = −1                       (conserved energy, E = 1)
//   E_loc = √f · |p_t| = √f       (local energy seen by static observer)
//
//   p_r = n_r                      (= √g_rr · E_loc · n_r / √g_rr = n_r)
//   p_θ = r · √f · n_θ            (= √g_θθ · E_loc · n_θ)
//   p_φ = r · sinθ · √f · n_φ     (= √g_φφ · E_loc · n_φ)
//
// Null condition g^μν p_μ p_ν = 0 is automatically satisfied by construction
// (|n|=1 ensures this).

void initRay(ivec2 pixel, ivec2 res, out vec4 pos, out vec4 mom) {
    float r_obs     = u_cam_distance;
    float theta_obs = u_cam_inclination * PI / 180.0;
    float fov_rad   = u_cam_fov * PI / 180.0;
    float f_obs     = 1.0 - u_rs / r_obs;
    float sqrtF     = sqrt(max(f_obs, 1e-8));

    // Screen coordinates → deflection angles
    float aspect = float(res.x) / float(res.y);
    float halfTan = tan(fov_rad * 0.5);

    // NDC in [-1, 1]
    float ndcX = 2.0 * (float(pixel.x) + 0.5) / float(res.x) - 1.0;
    float ndcY = 2.0 * (float(pixel.y) + 0.5) / float(res.y) - 1.0;

    // Angular deflection from boresight (radial inward direction)
    float alpha = ndcX * halfTan * aspect;   // horizontal
    float beta  = ndcY * halfTan;            // vertical

    // Local orthonormal 3-direction (unit vector, |n|=1)
    float n_r  = -cos(beta) * cos(alpha);    // inward (toward BH)
    float n_th =  sin(beta);                 // up on screen
    float n_ph =  cos(beta) * sin(alpha);    // right on screen

    // Observer position
    pos = vec4(0.0, r_obs, theta_obs, 0.0);

    // Covariant momenta from orthonormal frame
    float sinThObs = sin(theta_obs);
    float pt  = -1.0;                                // conserved energy
    float pr  = n_r;                                 // p_r
    float pth = r_obs * sqrtF * n_th;                // p_θ
    float pph = r_obs * sinThObs * sqrtF * n_ph;     // p_φ

    mom = vec4(pt, pr, pth, pph);
}

// ── Procedural starfield background ───────────────────────────────────────────
//
// Generates a starfield on the celestial sphere using hash-based pseudo-random
// stars, plus a Milky Way band and coordinate grid for visual reference.
//
// When gravitational lensing bends light rays, the apparent positions of stars
// shift — this is visible as distortion of the star pattern near the black hole,
// and as Einstein rings where stars are smeared into arcs.

// Hash function for procedural star placement
float hash(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

// 2D value noise for the Milky Way band
float valueNoise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);  // smoothstep

    float a = hash(i);
    float b = hash(i + vec2(1.0, 0.0));
    float c = hash(i + vec2(0.0, 1.0));
    float d = hash(i + vec2(1.0, 1.0));

    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

// Fractal Brownian motion (3 octaves)
float fbm(vec2 p) {
    float val = 0.0;
    float amp = 0.5;
    for (int i = 0; i < 3; ++i) {
        val += amp * valueNoise(p);
        p *= 2.0;
        amp *= 0.5;
    }
    return val;
}

vec3 skyColor(vec4 pos) {
    float theta = pos.z;
    float phi   = pos.w;

    // ── Point light source (Einstein ring feature) ────────────────────────────
    // Compute angular separation on the celestial sphere between the escaped
    // ray direction and the source position using the spherical law of cosines:
    //   cos(δ) = cos(θ₁)cos(θ₂) + sin(θ₁)sin(θ₂)cos(φ₁ − φ₂)
    // A smooth falloff models the apparent disk of the source.
    vec3 sourceColor = vec3(0.0);
    if (u_src_brightness > 0.0) {
        float srcTheta = u_src_theta * PI / 180.0;
        float srcPhi   = u_src_phi   * PI / 180.0;
        float srcRad   = u_src_radius * PI / 180.0;

        float cosAngSep = cos(theta) * cos(srcTheta)
                        + sin(theta) * sin(srcTheta) * cos(phi - srcPhi);
        cosAngSep = clamp(cosAngSep, -1.0, 1.0);
        float angSep = acos(cosAngSep);

        // Soft disk: bright core with smooth edge
        // Inner 50% of radius: full brightness; outer 50%: smoothstep fade
        float intensity = 1.0 - smoothstep(srcRad * 0.5, srcRad, angSep);
        sourceColor = vec3(1.0, 0.95, 0.85) * intensity * u_src_brightness;
    }

    // ── Base: dark sky gradient ───────────────────────────────────────────────
    // Slight blue tint varying with latitude
    float lat = abs(theta / PI - 0.5) * 2.0;  // 0 at equator, 1 at poles
    vec3 skyBase = mix(vec3(0.01, 0.01, 0.03),    // equator: very dark blue
                       vec3(0.005, 0.005, 0.015),  // poles: even darker
                       lat);

    // ── Milky Way band ────────────────────────────────────────────────────────
    // A bright diffuse band along the equator (θ ≈ π/2)
    float eqDist = abs(theta - PI * 0.5);              // distance from equator
    float milkyway = exp(-eqDist * eqDist * 8.0);      // Gaussian falloff
    float mwNoise = fbm(vec2(phi * 3.0, theta * 6.0)); // turbulent structure
    milkyway *= 0.15 * (0.5 + 0.5 * mwNoise);
    vec3 mwColor = vec3(0.8, 0.75, 0.6) * milkyway;

    // ── Stars ─────────────────────────────────────────────────────────────────
    // Multi-layer procedural stars at different scales / densities
    vec3 starColor = vec3(0.0);

    // Map (θ, φ) to a grid; at each cell, one potential star
    for (int layer = 0; layer < 3; ++layer) {
        float density = 40.0 + float(layer) * 30.0;  // grid cells: 40, 70, 100
        float brightness = 1.0 - float(layer) * 0.3;  // dimmer at higher density

        // Use sinθ scaling to avoid clustering at poles
        vec2 cell = vec2(phi * density / (2.0 * PI),
                         (theta - 0.5 * PI) * density / PI);
        vec2 cellId = floor(cell);
        vec2 cellFrac = fract(cell);

        // Pseudo-random star position within this cell
        float h = hash(cellId + float(layer) * 100.0);
        vec2 starPos = vec2(hash(cellId * 1.3 + 7.0 + float(layer) * 50.0),
                            hash(cellId * 2.7 + 13.0 + float(layer) * 50.0));

        // Distance from cell center to the star
        float d = length(cellFrac - starPos);

        // Star threshold: only ~30% of cells have a star
        if (h > 0.7) {
            // Star radius depends on hash (variety of sizes)
            float starRadius = 0.03 + 0.07 * hash(cellId * 3.1 + float(layer));
            float starBright = smoothstep(starRadius, 0.0, d);
            starBright *= brightness;

            // Star colour: slight variation (white, blue-white, yellow-white)
            float temp = hash(cellId * 5.3 + float(layer) * 17.0);
            vec3 sCol;
            if (temp < 0.3) {
                sCol = vec3(0.7, 0.8, 1.0);   // blue-white (hot star)
            } else if (temp < 0.7) {
                sCol = vec3(1.0, 1.0, 0.95);  // white
            } else {
                sCol = vec3(1.0, 0.9, 0.7);   // yellow-white (cool star)
            }

            starColor += sCol * starBright;
        }
    }

    // ── Coordinate grid (subtle) ──────────────────────────────────────────────
    // Thin lines every 30° in θ and φ for visual reference of lensing distortion
    float gridTh  = 1.0 - smoothstep(0.0, 0.015, abs(sin(theta * 6.0)));  // 30° = π/6
    float gridPhi = 1.0 - smoothstep(0.0, 0.015, abs(sin(phi   * 6.0)));
    float grid = max(gridTh, gridPhi);
    vec3 gridColor = vec3(0.05, 0.1, 0.15) * grid;

    // ── Combine ───────────────────────────────────────────────────────────────
    // Returned linear and unclamped so HDR sources (e.g. a bright point light)
    // are preserved for the global tone map at the end of main().
    vec3 color = skyBase + mwColor + starColor + gridColor + sourceColor;

    return color;
}

// ── Accretion disk emission ───────────────────────────────────────────────────
//
// Temperature profile (simplified Novikov-Thorne):
//   T(r) ∝ r^{-3/4} · [1 - √(r_in/r)]^{1/4}
//
// Maps to a blackbody-inspired colour palette:
//   hot (near ISCO)  → blue-white   (T ~ 1.0)
//   warm (mid disk)  → yellow-white (T ~ 0.5)
//   cool (outer edge) → red-orange   (T ~ 0.1)
//
// Gravitational redshift dims the emission by √f(r).
// Doppler boost from Keplerian orbital motion shifts the colour for
// gas moving toward/away from the observer.

vec3 diskEmission(float r, float phi, float rs, float r_in, float r_out, float temp_scale) {
    // Normalised radial coordinate: 0 at inner edge, 1 at outer edge
    float u = (r - r_in) / (r_out - r_in);
    u = clamp(u, 0.0, 1.0);

    // Novikov-Thorne temperature profile (simplified)
    float ratio = r_in / r;
    float T = pow(r_in / r, 0.75) * pow(max(1.0 - sqrt(ratio), 0.001), 0.25);
    T *= temp_scale;

    // Blackbody colour palette (normalised T from 0 to ~1)
    //   T > 0.8  → blue-white
    //   T ~ 0.5  → yellow-white
    //   T ~ 0.2  → orange
    //   T < 0.1  → deep red
    vec3 hotColor  = vec3(0.8, 0.85, 1.0);    // blue-white
    vec3 warmColor = vec3(1.0, 0.9, 0.6);     // yellow-white
    vec3 coolColor = vec3(1.0, 0.4, 0.1);     // orange-red
    vec3 coldColor = vec3(0.5, 0.1, 0.02);    // deep red

    vec3 diskColor;
    if (T > 0.6) {
        diskColor = mix(warmColor, hotColor, smoothstep(0.6, 1.0, T));
    } else if (T > 0.3) {
        diskColor = mix(coolColor, warmColor, smoothstep(0.3, 0.6, T));
    } else {
        diskColor = mix(coldColor, coolColor, smoothstep(0.0, 0.3, T));
    }

    // Gravitational redshift: emitted light is dimmed by √f at the emission point
    float f = max(1.0 - rs / r, 0.01);
    float redshift = sqrt(f);

    // Keplerian Doppler boost (for inclined views):
    // Orbital velocity v_orb = √(M / r) = √(rs / (2r)) in geometric units.
    // The line-of-sight component depends on azimuthal angle φ and inclination.
    // For a prograde disk, gas at angle φ moves in the +φ direction.
    // Doppler factor δ ≈ 1 / (1 - v_los), where v_los = v_orb · sin(φ) · sin(θ_obs).
    float v_orb = sqrt(rs / (2.0 * r));
    float theta_obs = u_cam_inclination * PI / 180.0;
    float v_los = v_orb * sin(phi) * sin(theta_obs);
    float doppler = 1.0 / (1.0 - clamp(v_los, -0.9, 0.9));

    // Combined intensity: temperature brightness × redshift × Doppler^3
    // (Doppler^3 for relativistic beaming of bolometric flux)
    float intensity = T * redshift * doppler * doppler * doppler;
    intensity = clamp(intensity, 0.0, 5.0);

    return diskColor * intensity;
}

// ── Adaptive step size ────────────────────────────────────────────────────────
// Scale the step down near the horizon to avoid numerical instability from
// the Boyer-Lindquist coordinate singularity at r = rs.

float adaptiveStep(float r, float rs, float h_base) {
    float dr = r - rs;
    const float k = 2.0;             // start shrinking at r ≈ 3·rs
    const float h_min_ratio = 0.01;  // floor at 1% of base step (float needs larger floor)
    float scale = dr / (k * rs);
    scale = max(scale, h_min_ratio);
    scale = min(scale, 1.0);
    return h_base * scale;
}

// ── Relativistic jet density ──────────────────────────────────────────────────
// Axisymmetric solid cone around the symmetry axis.  The emission volume is
// described in the (z, ρ) plane, with z = r·cosθ along the axis and
// ρ = r·sinθ the cylindrical radius:
//
//   rho_width(z) = base_radius + |z|^p · tan(opening_angle)   (p = profile_exponent)
//   gauss(ρ, z)  = exp( -(ρ / rho_width)² / (2·σ²) )           (transverse Gaussian)
//   axial(z)     = (1 + |z|/z_falloff)^(-axial_falloff)        (bounded at z = 0)
//   top(z)       = smoothstep(max_height, 0.8·max_height, |z|)
//   j(ρ, z)      = gauss · axial · top
//
// `p = 1` gives the cone; lowering it toward 0.5 turns the cone into a parabola
// by changing a single parameter.  The axial term is finite (= 1) on the axis
// at z = 0, so there is no central blow-up or hot spot, and the soft top fades
// the emission to zero before `max_height`, so there is no hard cut-off.
//
// The whole kernel is skipped for rays outside the solid of revolution (a cheap
// bounding early-out).  Emission is optically thin and added to every terminal
// colour, so the jet never occludes the disk, stars or Einstein rings.
float jetDensity(vec4 pos, float rBound) {
    float r     = pos.y;
    // ── Bounding early-out (radial) ───────────────────────────────────────────
    // The solid of revolution fits inside a sphere of radius rBound, so rays
    // beyond it can never sample the jet.  Cheapest possible reject: one compare
    // before the cos, catching the long outward legs of escaping rays.
    if (r >= rBound) return 0.0;

    float theta = pos.z;
    float z     = r * cos(theta);   // only cos is needed: ρ² = r² − z²
    float az    = abs(z);           // baryon-symmetric bipolar jet

    // ── Bounding early-out (axial): outside the finite extent, nothing to do ──
    // Cheap: rejects far rays after a single cos, before any profile work.
    if (az >= u_jet_max_height) return 0.0;

    float exponent = max(u_jet_profile_exponent, 0.05);   // protected shape exponent

    // Cone by default: p = 1 needs no pow; any other p turns it into a parabola.
    float axial_shape = az;
    if (abs(exponent - 1.0) > 1e-4) axial_shape = pow(az, exponent);

    float opening   = radians(u_jet_opening_angle);
    float rho_width = u_jet_base_radius + axial_shape * tan(opening);
    float sigma     = u_jet_radial_sigma;

    // ── Bounding early-out (transverse) ──────────────────────────────────────
    // Compare ρ² = r² − z² against (3σ·ρ_width)² — avoids sqrt/sin entirely.
    float rho2 = r * r - z * z;
    float lim  = 3.0 * sigma * rho_width;
    if (rho2 >= lim * lim) return 0.0;

    // Transverse Gaussian — solid volume, core-bright and rim-soft.
    float gauss = exp(-rho2 / (2.0 * sigma * sigma * rho_width * rho_width));

    // Bounded axial power-law: brightest at the base, declining outward.
    float axial = pow(1.0 + az / u_jet_z_falloff, -u_jet_axial_falloff);

    // Soft top: fade between 0.8·max_height and max_height → no hard cut-off.
    // Written the conformant way around (edge0 < edge1, then inverted), because
    // GLSL leaves smoothstep undefined for edge0 >= edge1.
    axial *= 1.0 - smoothstep(u_jet_max_height * 0.8, u_jet_max_height, az);

    return gauss * axial;
}

// ── Relativistic Doppler beaming ──────────────────────────────────────────────
// A single constant bulk velocity v = sign(z)·β·ẑ makes the lobe moving toward
// the observer brighter and the receding lobe dimmer (ticket 0006).  The Doppler
// factor is assembled in the static local frame from the covariant momenta the
// ray already carries (normalised to p_t = -1, i.e. E = 1):
//
//   n̂ = ( f·p_r, √f·p_θ/r, √f·p_φ/(r·sinθ) )   (observer → scene = march dir)
//   ẑ = cosθ·ê_r − sinθ·ê_θ                     (jet axis, local frame)
//   δ = 1 / [ γ·(1 − β·(v̂·(−n̂))) ],  γ = 1/√(1−β²)
//   gain = δ^(3 + α)                            (α = spectral index)
//
// Because the ray is traced backwards, the emitter → observer direction is the
// reverse of the march direction, hence the −n̂ (the classic sign trap).  β = 0
// returns 1, reproducing the unbeamed jet.  `f` is the caller's metric factor.
float jetBeamFactor(vec4 pos, vec4 mom, float f) {
    float beta = clamp(u_jet_bulk_velocity, -0.999, 0.999);
    if (abs(beta) < 1e-5) return 1.0;              // no bulk motion → unbeamed

    float r     = pos.y;
    float theta = pos.z;
    float sinT  = max(sin(theta), 1e-4);
    float cosT  = cos(theta);
    float sqrtF = sqrt(f);

    // Local photon direction of the backward march (observer → scene).
    vec3 n = vec3(f * mom.y,
                  sqrtF * mom.z / r,
                  sqrtF * mom.w / (r * sinT));

    // Bipolar bulk direction v̂ = sign(z)·ẑ, with sign(z) = sign(cosθ).
    float sz   = (cosT >= 0.0) ? 1.0 : -1.0;
    vec3  vhat = sz * vec3(cosT, -sinT, 0.0);

    // Emitter → observer is the reverse of the backward march, hence −n̂.
    // Clamp guards against any |n̂| drift so δ^… never sees a negative base.
    float cosAng = clamp(dot(vhat, -n), -1.0, 1.0);
    float gamma  = 1.0 / sqrt(1.0 - beta * beta);
    float delta  = 1.0 / (gamma * (1.0 - beta * cosAng));
    return pow(delta, 3.0 + u_jet_spectral_index);
}

// ── Main ──────────────────────────────────────────────────────────────────────

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);

    // Out-of-bounds guard
    if (pixel.x >= u_resolution.x || pixel.y >= u_resolution.y) return;

    vec4 pos, mom;
    initRay(pixel, u_resolution, pos, mom);

    // Enclosing-sphere radius of the jet (constant per frame).  The solid of
    // revolution spans |z| < max_height and ρ < 3σ·ρ_width, with
    // ρ_width ≤ base_radius + max_height^p·tan(opening); the largest corner is
    // at r = √(max_height² + ρ_max²).  Computed once per ray so the per-step
    // kernel can reject far steps with a single compare.  Unused when jet off.
    float jetRBound = 0.0;
    if (u_jet_enabled == 1) {
        float axialMax = pow(u_jet_max_height, max(u_jet_profile_exponent, 0.05));
        float rhoMax   = 3.0 * u_jet_radial_sigma *
                         (u_jet_base_radius + axialMax * tan(radians(u_jet_opening_angle)));
        jetRBound = sqrt(u_jet_max_height * u_jet_max_height + rhoMax * rhoMax) + 1.0;
    }

    vec3 color = vec3(0.0);
    int status = 0;  // 0 = active, 1 = captured, 2 = escaped, 3 = hit disk

    // Track closest approach to the black hole (for photon sphere effects)
    float r_min = pos.y;

    // Track total azimuthal winding (number of orbits around the BH)
    float totalDeltaPhi = 0.0;
    float prevPhi = pos.w;

    // ── Accretion disk crossing detection state ───────────────────────────────
    // We track the previous step's θ and r to detect when the ray crosses
    // the equatorial plane (θ = π/2).
    float prevTheta = pos.z;
    float prevR     = pos.y;
    vec3  diskColor = vec3(0.0);       // colour if ray hits the disk
    float diskAlpha = 0.0;             // accumulated disk opacity (for multiple crossings)
    vec3  diskAccum = vec3(0.0);       // accumulated disk emission from all crossings
    const float HALF_PI = PI * 0.5;

    // Optically-thin jet emission integrated along the ray (ticket 0004).
    vec3 jetAccum = vec3(0.0);

    for (int i = 0; i < u_max_steps; ++i) {
        float h_eff = adaptiveStep(pos.y, u_rs, u_step_size);
        rk4Step(pos, mom, u_rs, h_eff);

        // Clamp theta to avoid coordinate singularity at poles
        pos.z = clamp(pos.z, 0.001, PI - 0.001);

        float r = pos.y;
        r_min = min(r_min, r);

        // Accumulate azimuthal winding (handle wrap-around)
        float dPhi = pos.w - prevPhi;
        if (dPhi > PI)  dPhi -= 2.0 * PI;
        if (dPhi < -PI) dPhi += 2.0 * PI;
        totalDeltaPhi += abs(dPhi);
        prevPhi = pos.w;

        // ── Relativistic jet accumulation ─────────────────────────────────────
        // Emitted additively and optically thin: the jet never occludes the
        // disk, stars or Einstein rings.  Sampled once per geodesic step and
        // integrated over the local proper length ds = h_eff / √f, which makes
        // the result independent of the base step size.  Accumulated here —
        // before the disk-crossing test — so a ray that terminates on the disk
        // carries exactly the foreground jet accumulated up to the hit.
        if (u_jet_enabled == 1) {
            float j = jetDensity(pos, jetRBound);
            if (j > 0.0) {
                float f  = max(1.0 - u_rs / r, 1e-4);
                float ds = h_eff / sqrt(f);
                // Relativistic beaming multiplies the emission rate (ticket 0006).
                jetAccum += JET_COLOR * (u_jet_emissivity * j * jetBeamFactor(pos, mom, f)) * ds;
            }
        }

        // ── Disk crossing check ───────────────────────────────────────────────
        // Detect when the ray crosses θ = π/2 between consecutive steps.
        // The disk is optically thick, so the first crossing terminates the ray
        // (the disk is opaque — light does not pass through it).
        if (u_disk_enabled == 1 && status == 0) {
            float dThPrev = prevTheta - HALF_PI;
            float dThCurr = pos.z     - HALF_PI;

            // Sign change → crossing occurred
            if (dThPrev * dThCurr < 0.0) {
                // Linear interpolation to find crossing point
                float t_cross = dThPrev / (dThPrev - dThCurr);
                float r_cross = prevR + t_cross * (r - prevR);
                float phi_cross = prevPhi + t_cross * dPhi;

                // Check if crossing radius is within disk bounds
                if (r_cross >= u_disk_inner && r_cross <= u_disk_outer) {
                    // Ray hits the disk — compute emission
                    diskAccum = diskEmission(r_cross, phi_cross, u_rs,
                                             u_disk_inner, u_disk_outer, u_disk_temp);
                    status = 3;  // hit disk (opaque — terminates ray)
                    break;
                }
            }
        }

        // Update previous-step state for next crossing check
        prevTheta = pos.z;
        prevR     = r;

        // Termination: captured by black hole
        if (r <= u_rs * 1.05) {
            status = 1;
            break;
        }

        // Termination: escaped to infinity
        if (r > u_abort_distance) {
            status = 2;
            break;
        }
    }

    // ── Colour based on termination ───────────────────────────────────────────
    //
    // Photon sphere shadow (Feature 8):
    //
    // The photon sphere at r = 1.5·rs hosts unstable circular photon orbits.
    // Rays that pass close to it undergo strong deflection:
    //   - Rays just inside the critical impact parameter → CAPTURED (black)
    //   - Rays just outside → ESCAPED but highly wound (photon ring)
    //
    // The "shadow" is the sharp boundary between captured and escaped rays.
    // We enhance the shadow edge by:
    //   1. Rendering a bright photon ring at the boundary — escaped rays that
    //      came close to the photon sphere (small r_min) are brightened based
    //      on how many times they wound around the BH (totalDeltaPhi).
    //   2. Keeping the interior (captured) pure black.
    //
    // The photon ring brightness ~ number of half-orbits, because each orbit
    // collects light from different sky directions, creating the classic
    // "stacked image" effect near the shadow edge.

    float r_photon = 1.5 * u_rs;  // photon sphere radius

    if (status == 1) {
        // ── Captured: pure black (inside the shadow) ──────────────────────────
        color = vec3(0.0);

    } else if (status == 3) {
        // ── Hit accretion disk ────────────────────────────────────────────────
        // Opaque disk: the ray terminates with the disk emission colour.
        // Kept linear and unclamped here — the global tone map below handles
        // HDR roll-off instead of clipping.
        color = diskAccum;

    } else if (status == 2) {
        // ── Escaped: background starfield + photon ring glow ──────────────────
        vec3 sky = skyColor(pos);

        // Photon ring enhancement:
        // Rays that grazed the photon sphere (r_min close to r_photon)
        // are brightened. The closer to the critical orbit, the more the ray
        // wound around the BH, and the brighter the accumulated glow.
        float proximity = (r_min - u_rs) / (r_photon - u_rs);  // 0 at horizon, 1 at photon sphere
        proximity = clamp(proximity, 0.0, 3.0);

        // Number of half-orbits as a glow factor
        // A ray at the photon sphere would orbit forever; near it, it winds
        // several times. Each winding ≈ π radians of azimuthal travel.
        float nOrbits = totalDeltaPhi / (2.0 * PI);

        // Glow is strongest when r_min is near r_photon and winding is high
        float glowStrength = 0.0;
        if (proximity < 2.0) {
            // Exponential glow based on winding number
            // More orbits = exponentially brighter (logarithmic pileup)
            glowStrength = max(0.0, nOrbits - 0.5);  // subtract baseline half-orbit
            glowStrength = 1.0 - exp(-glowStrength * 1.5);

            // Sharpen near the photon sphere
            float edge = smoothstep(2.0, 0.5, proximity);
            glowStrength *= edge;
        }

        // Photon ring colour: warm white-gold (gravitationally blueshifted light)
        vec3 ringColor = vec3(1.0, 0.95, 0.8);

        color = sky + ringColor * glowStrength * 0.8;

    } else {
        // ── MAX_STEPS: photon sphere orbit (debug) ────────────────────────────
        // These rays are trapped near r_photon — show as dim orange ring
        // instead of harsh magenta, since they represent real photon ring light.
        float proximity = (r_min - u_rs) / (r_photon - u_rs);
        if (proximity > 0.5 && proximity < 1.5) {
            // Near photon sphere — show as photon ring
            float nOrbits = totalDeltaPhi / (2.0 * PI);
            float glow = 1.0 - exp(-nOrbits * 0.5);
            color = vec3(1.0, 0.85, 0.6) * glow;
        } else {
            color = vec3(1.0, 0.0, 1.0);  // Magenta — genuine convergence failure
        }
    }

    // ── Additive jet compositing ──────────────────────────────────────────────
    // The optically-thin jet is added on top of every terminal colour (shadow,
    // disk, sky), so it is visible in front of the shadow and lenses with the
    // geodesics, without ever occluding what is behind it.
    color += jetAccum;

    // ── Global tone mapping (display transform) ───────────────────────────────
    // Map linear HDR radiance to displayable LDR. With the defaults
    // (exposure = 1, gamma = 1) the normal range is left untouched — visually
    // identical to the previous clamp — while HDR pixels (photon-ring glow,
    // point source) roll off smoothly instead of clipping to flat white.
    //   exposure  → linear scale
    //   soft knee → identity below `knee`, compresses highlights above it,
    //               approaching `knee + width` (never reaches it)
    //   gamma     → optional display encoding (default 1.0 = identity)
    vec3 c = max(color * u_exposure, 0.0);
    const float knee  = 0.8;
    const float width = 0.2;
    vec3 over = max(c - knee, 0.0);
    vec3 mapped = min(c, knee) + over * width / (width + over);
    mapped = pow(mapped, vec3(1.0 / max(u_gamma, 1e-3)));

    imageStore(outputImage, pixel, vec4(mapped, 1.0));
}
